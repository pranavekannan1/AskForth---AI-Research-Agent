GROQ_API_KEY=replace-with-a-new-key
APP_NAME=Askforth AI Research Agent
APP_VERSION=1.0.0
# Comma-separated browser origins. The default includes local development and
# the production Vercel site; preview URLs are covered by CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ask-forth-ai-research-agent.vercel.app
CORS_ORIGIN_REGEX=https://ask-forth-ai-research-agent(?:-[a-z0-9-]+)?\.vercel\.app
